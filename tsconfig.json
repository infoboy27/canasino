{
  "compilerOptions": {
    "allowJs": true, "checkJs": true, "noEmit": true,
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": false, "skipLibCheck": true, "jsx": "react-jsx", "types": ["vite/client"]
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.d.ts"]
}
