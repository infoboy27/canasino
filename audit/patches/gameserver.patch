+def _serialized_store(cls):
+    """A shared SQLite connection must not interleave transactions across threads.
+
+    Wrapping the full method also rolls back history and stats together on error.
+    INSERT OR IGNORE below handles competing *connections*, not just this lock.
+    """
+    def serialized(method):
+        @wraps(method)
+        def call(self, *args, **kwargs):
+            with self._lock, self._conn:
+                return method(self, *args, **kwargs)
+        return call
+
+    for name, method in list(vars(cls).items()):
+        if callable(method) and not name.startswith("_") and name != "close":
+            setattr(cls, name, serialized(method))
+    return cls
+
