+import hashlib
+import os
+import unittest
+import uuid
+from unittest.mock import patch
+
+from blspy import BasicSchemeMPL
+from fastapi.testclient import TestClient
+
+from gameserver.app import create_app
+from gameserver.auth import payload_hash
+from gameserver.chain import ReceiptInvalid, ReceiptPending
+from gameserver.db import Store
+from tests.fakes import FakeBridge
+
+
+class ReceiptBridge(FakeBridge):
+    def __init__(self):
+        super().__init__()
+        self.receipt_mode = "valid"
+        self.receipt_calls = []
+
+    def transaction_receipt(self, tx_hash, *, sender, message_type, expected_fields=None):
+        self.receipt_calls.append({
+            "tx_hash": tx_hash, "sender": sender, "message_type": message_type,
+            "expected_fields": expected_fields,
+        })
+        if self.receipt_mode == "pending":
+            raise ReceiptPending("needs another confirmation")
+        if self.receipt_mode == "invalid":
+            raise ReceiptInvalid("transaction signer mismatch")
+        return {"height": 777, "confirmations": 2}
+
+
+class WalletRegistrationTests(unittest.TestCase):
+    def setUp(self):
+        env = patch.dict(os.environ, {
+            "CASINO_ADMIN_TOKEN": "wallet-registration-operator",
+            "CASINO_AUTH_DOMAIN": "test.canasino.invalid",
+        })
+        env.start()
+        self.addCleanup(env.stop)
+        self.store = Store(":memory:")
+        self.bridge = ReceiptBridge()
+        self.app = create_app(self.bridge, self.store)
+        self.client = TestClient(self.app)
+        self.addCleanup(self.client.close)
+        self.addCleanup(self.store.close)
+        self.admin = {"Authorization": "Bearer wallet-registration-operator"}
+        self.sk = BasicSchemeMPL.key_gen(b"wallet-registration-seed-value-32")
+        self.public_key = bytes(self.sk.get_g1())
+        self.address = hashlib.sha256(self.public_key).digest()[:20].hex()
+
+    def grant(self, action, resource, body):
+        challenge_response = self.client.post("/auth/challenges", json={
+            "address": self.address, "action": action, "resource": resource,
+            "payload_hash": payload_hash(body),
+        })
+        self.assertEqual(challenge_response.status_code, 200, challenge_response.text)
+        challenge = challenge_response.json()
+        signature = BasicSchemeMPL.sign(self.sk, bytes.fromhex(challenge["messageHex"]))
+        response = self.client.post("/auth/verify", json={
+            "challenge_id": challenge["challengeId"], "public_key": self.public_key.hex(),
+            "signature": bytes(signature).hex(),
+        })
+        self.assertEqual(response.status_code, 200, response.text)
+        return response.json()["grant"]
+
+    def open_round(self, game):
+        if game == "bingo":
+            response = self.client.post("/rounds", headers=self.admin, json={"room": "classic"})
+        else:
+            response = self.client.post(f"/{game}/rounds", headers=self.admin, json={})
+        self.assertEqual(response.status_code, 200, response.text)
+        return response.json()["roundId"]
+
+    def case(self, game, tx_byte="12"):
+        rid = self.open_round(game)
+        operation_id = str(uuid.uuid4())
+        body = {"address": self.address, "operation_id": operation_id, "tx_hash": tx_byte * 32}
+        if game == "bingo":
+            body["num_cards"] = 2
+            path, action, resource = f"/rounds/{rid}/register", "join_room", f"round:{rid}"
+        elif game == "roulette":
+            body.update({"bet_type": "red", "bet_number": 0, "amount": 1_000_000})
+            path, action, resource = (f"/roulette/rounds/{rid}/register", "roulette_bet",
+                                      f"roulette-round:{rid}")
+        else:
+            path = f"/{game}/rounds/{rid}/register"
+            action = f"join_{game}"
+            resource = f"{game}-round:{rid}"
+        return path, action, resource, body
+
+    def test_all_four_wallet_registrations_require_exact_receipt_and_become_applied(self):
+        for index, game in enumerate(("bingo", "roulette", "domino", "poker"), start=1):
+            with self.subTest(game=game):
+                path, action, resource, body = self.case(game, f"{index:02x}")
+                grant = self.grant(action, resource, body)
+                response = self.client.post(
+                    path, json=body, headers={"Authorization": f"Canasino-Wallet {grant}"},
+                )
+                self.assertEqual(response.status_code, 200, response.text)
+                self.assertEqual(response.json()["operationState"], "APPLIED")
+                self.assertEqual(response.json()["receiptHeight"], 777)
+                receipt_call_count = len(self.bridge.receipt_calls)
+                replay = self.client.post(
+                    path, json=body, headers={"Authorization": "Canasino-Wallet consumed"},
+                )
+                self.assertEqual(replay.status_code, 200, replay.text)
+                self.assertEqual(replay.json()["operationState"], "APPLIED")
+                self.assertEqual(len(self.bridge.receipt_calls), receipt_call_count)
+
+    def test_pending_receipt_resumes_with_consumed_grant(self):
+        path, action, resource, body = self.case("bingo")
+        grant = self.grant(action, resource, body)
+        self.bridge.receipt_mode = "pending"
+        pending = self.client.post(
+            path, json=body, headers={"Authorization": f"Canasino-Wallet {grant}"},
+        )
+        self.assertEqual(pending.status_code, 425, pending.text)
+        self.assertEqual(self.store.get_operation(body["operation_id"])["state"], "PENDING")
+        self.bridge.receipt_mode = "valid"
+        resumed = self.client.post(
+            path, json=body, headers={"Authorization": "Canasino-Wallet already-consumed"},
+        )
+        self.assertEqual(resumed.status_code, 200, resumed.text)
+        self.assertEqual(resumed.json()["operationState"], "APPLIED")
+
+    def test_invalid_receipt_is_permanently_rejected(self):
+        path, action, resource, body = self.case("roulette")
+        grant = self.grant(action, resource, body)
+        self.bridge.receipt_mode = "invalid"
+        rejected = self.client.post(
+            path, json=body, headers={"Authorization": f"Canasino-Wallet {grant}"},
+        )
+        self.assertEqual(rejected.status_code, 422, rejected.text)
+        self.assertEqual(self.store.get_operation(body["operation_id"])["state"], "REJECTED")
+        replay = self.client.post(
+            path, json=body, headers={"Authorization": "Canasino-Wallet consumed"},
+        )
+        self.assertEqual(replay.status_code, 409, replay.text)
+
+    def test_one_chain_transaction_cannot_back_two_operations(self):
+        path, action, resource, first_body = self.case("domino")
+        first_grant = self.grant(action, resource, first_body)
+        first = self.client.post(
+            path, json=first_body, headers={"Authorization": f"Canasino-Wallet {first_grant}"},
+        )
+        self.assertEqual(first.status_code, 200, first.text)
+        second_body = {**first_body, "operation_id": str(uuid.uuid4())}
+        second_grant = self.grant(action, resource, second_body)
+        second = self.client.post(
+            path, json=second_body, headers={"Authorization": f"Canasino-Wallet {second_grant}"},
+        )
+        self.assertEqual(second.status_code, 409, second.text)
+        self.assertEqual(second.json()["code"], "operation_conflict")
+
+    def test_wallet_scheme_is_scoped_to_registration_routes(self):
+        headers = {"Authorization": "Canasino-Wallet anything"}
+        self.assertEqual(self.client.post("/rounds", headers=headers, json={"room": "classic"}).status_code, 401)
+
+
+if __name__ == "__main__":
+    unittest.main()
