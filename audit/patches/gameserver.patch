@@ -0,0 +1,101 @@
+"""Fail-closed transport policy until wallet-bound authentication is implemented.
+
+An address is public information, not proof of ownership. The operator bearer
+credential is for trusted server-side operations only and MUST NOT reach a browser.
+"""
+
+import asyncio
+import re
+import secrets
+
+from starlette.datastructures import Headers
+from starlette.responses import JSONResponse
+
+MAX_BODY_BYTES = 16_384
+PUBLIC_POST_PATHS = frozenset({"/auth/challenges", "/auth/verify"})
+WALLET_POST_PATHS = (
+    re.compile(r"^/rounds/[0-9a-fA-F]{16}/register$"),
+    re.compile(r"^/(?:roulette|domino|poker)/rounds/[0-9a-fA-F]{16}/register$"),
+)
+
+
+def _wallet_route(path: str) -> bool:
+    return any(pattern.fullmatch(path) for pattern in WALLET_POST_PATHS)
+
+
+class OperatorBoundary:
+    def __init__(self, app, token: str, origins: list[str]):
+        self.app = app
+        self.expected = f"Bearer {token}".encode()
+        self.origins = frozenset(origins)
+
+    async def __call__(self, scope, receive, send):
+        if scope["type"] not in ("http", "websocket"):
+            return await self.app(scope, receive, send)
+        headers = Headers(scope=scope)
+        websocket = scope["type"] == "websocket"
+        # All current sockets either drive settlement or expose live game state.
+        # Keep them operator-only until player sessions and bounded subscriptions
+        # exist; never put this bearer credential into a URL.
+        public_auth = not websocket and scope["path"] in PUBLIC_POST_PATHS
+        private = websocket or (scope["method"] not in ("GET", "HEAD", "OPTIONS") and not public_auth) or (
+            scope["path"].rstrip("/").endswith(("/hand", "/card"))
+        )
+        authorization = headers.getlist("authorization")
+        operator_authenticated = len(authorization) == 1 and secrets.compare_digest(
+            authorization[0].encode(), self.expected
+        )
+        wallet_authenticated = (
+            not websocket and scope["method"] == "POST" and _wallet_route(scope["path"])
+            and len(authorization) == 1 and authorization[0].startswith("Canasino-Wallet ")
+            and len(authorization[0]) > len("Canasino-Wallet ")
+        )
+        authenticated = operator_authenticated or wallet_authenticated
+        if websocket:
+            origin = headers.get("origin")
+            if not authenticated or (origin is not None and origin not in self.origins):
+                await send({"type": "websocket.close", "code": 1008})
+                return
+        elif private and not authenticated:
+            return await JSONResponse(
+                {"detail": "Wallet authentication is unavailable; trusted operator access required.",
+                 "code": "wallet_auth_required"}, status_code=401,
+                headers={"WWW-Authenticate": "Bearer", "Cache-Control": "no-store"},
+            )(scope, receive, send)
+
+        if not websocket:
+            # Bound chunked bodies too, before FastAPI materializes the JSON.
+            body = bytearray()
+            more = True
+            try:
+                async with asyncio.timeout(10):
+                    while more:
+                        message = await receive()
+                        if message["type"] == "http.disconnect":
+                            return
+                        body.extend(message.get("body", b""))
+                        if len(body) > MAX_BODY_BYTES:
+                            return await JSONResponse({"detail": "Request body too large"}, 413)(scope, receive, send)
+                        more = message.get("more_body", False)
+            except TimeoutError:
+                return await JSONResponse({"detail": "Request body timed out"}, 408)(scope, receive, send)
+            delivered = False
+
+            async def bounded_receive():
+                nonlocal delivered
+                if not delivered:
+                    delivered = True
+                    return {"type": "http.request", "body": bytes(body), "more_body": False}
+                return await receive()
+
+            async def secure_send(message):
+                if message["type"] == "http.response.start":
+                    message["headers"] = list(message.get("headers", [])) + [
+                        (b"x-content-type-options", b"nosniff"),
+                        (b"cache-control", b"no-store"),
+                        (b"referrer-policy", b"no-referrer"),
+                    ]
+                await send(message)
+
+            return await self.app(scope, bounded_receive, secure_send)
+        return await self.app(scope, receive, send)
diff --git a/gameserver/synchronization.py b/gameserver/synchronization.py
new file mode 100644
index 0000000..e1b30cc
--- /dev/null
+++ b/gameserver/synchronization.py
@@ -0,0 +1,31 @@
+"""Serialize in-process room transitions; not a distributed transaction lock.
+
+The deployment must use a single game-server process until state transitions
+and transaction recovery are backed by a durable shared coordinator.
+"""
+
+from copy import deepcopy
+from functools import wraps
+
+
+def synchronized(method):
+    @wraps(method)
+    def call(self, *args, **kwargs):
+        with self._state_lock:
+            return method(self, *args, **kwargs)
+    return call
+
+
+def settled_once(method):
+    @wraps(method)
+    def call(self, round_id_hex, *args, **kwargs):
+        with self._state_lock:
+            if round_id_hex in self._settled_results:
+                return deepcopy(self._settled_results[round_id_hex])
+            rnd = self.rounds[round_id_hex]
+            if rnd.status != "open":
+                raise ValueError("round is not open; settlement needs reconciliation")
+            result = method(self, round_id_hex, *args, **kwargs)
+            self._settled_results[round_id_hex] = deepcopy(result)
+            return result
+    return call
