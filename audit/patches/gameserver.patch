+++ b/tests/test_chain_receipts.py
@@ -0,0 +1,85 @@
+import json
+import unittest
+
+from gameserver.chain import CanopyBridge, ReceiptInvalid, ReceiptPending
+
+
+TX_HASH = "ab" * 32
+SENDER = "12" * 20
+
+
+class ReceiptBridge(CanopyBridge):
+    def __init__(self, result, chain_height=102, confirmations=2):
+        super().__init__(query_url="http://test", chain_id=406, network_id=1,
+                         finality_confirmations=confirmations)
+        self.result = result
+        self.chain_height = chain_height
+
+    def _post(self, url, body):
+        if url.endswith("/v1/query/tx-by-hash"):
+            if body != {"hash": TX_HASH}:
+                raise AssertionError("receipt lookup must use the exact hash")
+            return json.dumps(self.result)
+        raise AssertionError(url)
+
+    def height(self):
+        return self.chain_height
+
+
+def valid_result():
+    return {
+        "sender": SENDER,
+        "messageType": "join_room",
+        "height": 101,
+        "committed": True,
+        "txHash": TX_HASH,
+        "transaction": {
+            "type": "join_room", "networkID": 1, "chainID": 406,
+            "msg": {"messageJoinRoom": {
+                "playerAddress": SENDER, "roundId": "34" * 8,
+                "numCards": 1, "amount": 100,
+            }},
+        },
+    }
+
+
+class TransactionReceiptTests(unittest.TestCase):
+    def verify(self, result=None, **kwargs):
+        return ReceiptBridge(result or valid_result(), **kwargs).transaction_receipt(
+            TX_HASH, sender=SENDER, message_type="join_room",
+            expected_fields={"playerAddress": SENDER, "roundId": "34" * 8,
+                             "numCards": 1, "amount": 100},
+        )
+
+    def test_exact_committed_receipt_with_finality_is_accepted(self):
+        receipt = self.verify()
+        self.assertEqual(receipt["confirmations"], 2)
+
+    def test_pending_or_insufficient_finality_is_retryable(self):
+        pending = valid_result(); pending["committed"] = False
+        with self.assertRaises(ReceiptPending): self.verify(pending)
+        with self.assertRaises(ReceiptPending): self.verify(chain_height=101)
+
+    def test_signer_type_network_hash_and_payload_must_match(self):
+        mutations = [
+            ("sender", "ff" * 20),
+            ("messageType", "send"),
+            ("txHash", "ff" * 32),
+        ]
+        for field, value in mutations:
+            result = valid_result(); result[field] = value
+            with self.subTest(field=field), self.assertRaises(ReceiptInvalid): self.verify(result)
+        result = valid_result(); result["transaction"]["chainID"] = 1
+        with self.assertRaises(ReceiptInvalid): self.verify(result)
+        result = valid_result(); result["transaction"]["msg"]["messageJoinRoom"]["amount"] = 101
+        with self.assertRaises(ReceiptInvalid): self.verify(result)
+
+    def test_invalid_hash_is_rejected_before_network(self):
+        with self.assertRaises(ReceiptInvalid):
+            ReceiptBridge(valid_result()).transaction_receipt(
+                "bad", sender=SENDER, message_type="join_room",
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_custodial_join_recovery.py b/tests/test_custodial_join_recovery.py
new file mode 100644
index 0000000..231142f
--- /dev/null
+++ b/tests/test_custodial_join_recovery.py
@@ -0,0 +1,118 @@
+"""Fault-injection coverage for the fund -> join custodial saga.
+
+These legacy custodial helpers are not the real-money wallet path, but they
+must still be restart-safe: a lost response after either chain transaction
+cannot lose the generated player key or mint/escrow twice on recovery.
+"""
+
+import os
+import tempfile
+import unittest
+
+from gameserver.db import Store
+from gameserver.domino_rooms import DominoManager
+from gameserver.poker_rooms import PokerManager
+from gameserver.roulette_rooms import RouletteManager
+from gameserver.rooms import RoomManager
+
+from .fakes import FakeBridge
+
+
+class AcceptedThenCrashedBridge(FakeBridge):
+    """Idempotent chain double that loses the first join response."""
+
+    def __init__(self):
+        super().__init__()
+        self.applied = set()
+        self.apply_counts = {}
+        self.crashed = False
+
+    def _accept(self, operation_id, apply):
+        if operation_id not in self.applied:
+            apply()
+            self.applied.add(operation_id)
+            self.apply_counts[operation_id] = self.apply_counts.get(operation_id, 0) + 1
+
+    def buy_coins(self, admin, recipient, amount, operation_id=None):
+        self._accept(operation_id, lambda: self.balances.__setitem__(
+            recipient, self.balances.get(recipient, 0) + amount,
+        ))
+        return "0xbuy"
+
+    def _join(self, player, amount, operation_id, tx_hash):
+        self._accept(operation_id, lambda: self.balances.__setitem__(
+            player.address, self.balances.get(player.address, 0) - amount,
+        ))
+        if not self.crashed:
+            self.crashed = True
+            raise ConnectionError("response lost after accepted join")
+        return tx_hash
+
+    def join_room(self, player, round_id, num_cards, amount, operation_id=None):
+        return self._join(player, amount, operation_id, "0xjoin")
+
+    def roulette_bet(self, player, round_id, bet_type, bet_number, amount, operation_id=None):
+        return self._join(player, amount, operation_id, "0xbet")
+
+    def join_domino(self, player, round_id, amount, operation_id=None):
+        return self._join(player, amount, operation_id, "0xjoindomino")
+
+    def join_poker(self, player, round_id, amount, operation_id=None):
+        return self._join(player, amount, operation_id, "0xjoinpoker")
+
+
+class CustodialJoinRecoveryTests(unittest.TestCase):
+    def _exercise(self, game):
+        with tempfile.TemporaryDirectory() as tmp:
+            store = Store(os.path.join(tmp, "recovery.db"))
+            self.addCleanup(store.close)
+            bridge = AcceptedThenCrashedBridge()
+            operator = bridge.new_key("operator")
+
+            if game == "bingo":
+                manager = RoomManager(bridge, operator, store)
+                rnd = manager.create_round(entry_fee=100, room="classic")
+                invoke = lambda: manager.add_player(rnd.id_hex, 1)
+                manager_type = RoomManager
+                contains = lambda fresh, address: address in fresh.rounds[rnd.id_hex].participants
+            elif game == "roulette":
+                manager = RouletteManager(bridge, operator, store)
+                rnd = manager.open_round(1000)
+                invoke = lambda: manager.place_bet(rnd.id_hex, "red", 0, 100)
+                manager_type = RouletteManager
+                contains = lambda fresh, address: address in fresh.rounds[rnd.id_hex].bets
+            elif game == "domino":
+                manager = DominoManager(bridge, operator, store)
+                rnd = manager.open_round(100, 1000)
+                invoke = lambda: manager.join(rnd.id_hex)
+                manager_type = DominoManager
+                contains = lambda fresh, address: address in fresh.rounds[rnd.id_hex].participants
+            else:
+                manager = PokerManager(bridge, operator, store)
+                rnd = manager.open_round(10, 20, 100, 1000)
+                invoke = lambda: manager.join(rnd.id_hex)
+                manager_type = PokerManager
+                contains = lambda fresh, address: address in fresh.rounds[rnd.id_hex].participants
+
+            with self.assertRaisesRegex(ConnectionError, "response lost"):
+                invoke()
+            pending = store.pending_custodial_joins(game)
+            self.assertEqual(len(pending), 1)
+            address = pending[0]["address"]
+            self.assertEqual(pending[0]["state"], "FUNDED")
+
+            fresh = manager_type(bridge, operator, store)
+            self.assertTrue(contains(fresh, address))
+            self.assertEqual(store.get_custodial_join(game, rnd.id_hex, address)["state"], "APPLIED")
+            self.assertEqual(bridge.balances[address], 0)
+            related = [count for op, count in bridge.apply_counts.items() if address in op]
+            self.assertEqual(related, [1, 1], "fund and join must each apply exactly once")
+
+    def test_all_custodial_game_joins_resume_after_lost_response(self):
+        for game in ("bingo", "roulette", "domino", "poker"):
+            with self.subTest(game=game):
+                self._exercise(game)
+
+
+if __name__ == "__main__":
+    unittest.main()
