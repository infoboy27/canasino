new file mode 100755
index 0000000..b7c4f28
--- /dev/null
+++ b/scripts_verify_backup.sh
@@ -0,0 +1,40 @@
+#!/bin/sh
+set -eu
+
+if [ "$#" -ne 1 ]; then
+  echo "usage: $0 /absolute/path/to/manifest-TIMESTAMP.sha256" >&2
+  exit 2
+fi
+
+MANIFEST=$1
+case "$MANIFEST" in
+  /*/manifest-*.sha256) ;;
+  *) echo "manifest must be an absolute manifest-*.sha256 path" >&2; exit 2 ;;
+esac
+
+BACKUP_DIR=$(dirname "$MANIFEST")
+cd "$BACKUP_DIR"
+sha256sum -c "$(basename "$MANIFEST")"
+
+DB_GZ=$(awk '/canasino-.*\.db\.gz$/ {print $2}' "$MANIFEST" | head -1)
+if [ -z "$DB_GZ" ] || [ ! -f "$DB_GZ" ]; then
+  echo "database archive missing from manifest" >&2
+  exit 1
+fi
+
+gzip -cd "$DB_GZ" | python3 -c '
+import os, sqlite3, sys, tempfile
+fd, path = tempfile.mkstemp(prefix="canasino-restore-", suffix=".db")
+try:
+    with os.fdopen(fd, "wb") as out:
+        while chunk := sys.stdin.buffer.read(1024 * 1024):
+            out.write(chunk)
+    db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
+    result = db.execute("PRAGMA integrity_check").fetchone()[0]
+    db.close()
+    if result != "ok":
+        raise SystemExit(f"restore integrity_check failed: {result}")
+    print("RESTORE_VERIFY_OK")
+finally:
+    os.unlink(path)
+'
diff --git a/scripts_verify_runtime.sh b/scripts_verify_runtime.sh
new file mode 100644
index 0000000..6d2eab3
--- /dev/null
+++ b/scripts_verify_runtime.sh
@@ -0,0 +1,35 @@
+#!/bin/sh
+set -eu
+
+container="${1:-canasino-gameserver}"
+expected_revision="${EXPECTED_REVISION:?set EXPECTED_REVISION to the approved full Git commit}"
+expected_image_id="${EXPECTED_IMAGE_ID:-}"
+
+running="$(docker inspect --format '{{.State.Running}}' "$container")"
+[ "$running" = "true" ] || {
+    echo "runtime verification failed: container is not running" >&2
+    exit 1
+}
+
+image_id="$(docker inspect --format '{{.Image}}' "$container")"
+image_revision="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$image_id")"
+
+[ "$image_revision" = "$expected_revision" ] || {
+    echo "runtime verification failed: OCI revision does not match approved commit" >&2
+    exit 1
+}
+
+if [ -n "$expected_image_id" ] && [ "$image_id" != "$expected_image_id" ]; then
+    echo "runtime verification failed: image digest does not match approved artifact" >&2
+    exit 1
+fi
+
+health="$(docker exec "$container" python -c \
+    "import json,urllib.request; print(json.load(urllib.request.urlopen('http://127.0.0.1:8090/health', timeout=2))['ok'])")"
+[ "$health" = "True" ] || {
+    echo "runtime verification failed: health endpoint is not OK" >&2
+    exit 1
+}
+
+printf 'RUNTIME_VERIFIED container=%s image=%s revision=%s\n' \
+    "$container" "$image_id" "$image_revision"
