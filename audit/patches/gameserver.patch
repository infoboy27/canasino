new file mode 100644
index 0000000..fc9339e
--- /dev/null
+++ b/tests/test_wallet_auth.py
@@ -0,0 +1,190 @@
+import concurrent.futures
+import hashlib
+import os
+import unittest
+import uuid
+from unittest.mock import patch
+
+from blspy import BasicSchemeMPL
+from fastapi.testclient import TestClient
+
+from gameserver.app import create_app
+from gameserver.auth import AuthError, WalletAuthorizer, payload_hash
+from gameserver.db import Store
+from tests.fakes import FakeBridge
+
+
+class WalletAuthorizationTests(unittest.TestCase):
+    def setUp(self):
+        env = patch.dict(os.environ, {
+            "CASINO_ADMIN_TOKEN": "wallet-auth-test-operator",
+            "CASINO_AUTH_DOMAIN": "test.canasino.invalid",
+        })
+        env.start()
+        self.addCleanup(env.stop)
+        self.store = Store(":memory:")
+        self.bridge = FakeBridge()
+        self.app = create_app(self.bridge, self.store)
+        self.client = TestClient(self.app)
+        self.addCleanup(self.client.close)
+        self.addCleanup(self.store.close)
+        self.sk = BasicSchemeMPL.key_gen(b"wallet-auth-test-seed-material-32")
+        self.public_key = bytes(self.sk.get_g1())
+        self.address = hashlib.sha256(self.public_key).digest()[:20].hex()
+        self.payload = {"amount": 100, "roundId": "ab" * 8}
+
+    def challenge(self, **changes):
+        body = {
+            "address": self.address,
+            "action": "join_room",
+            "resource": f"round:{'ab' * 8}",
+            "payload_hash": payload_hash(self.payload),
+        }
+        body.update(changes)
+        return self.client.post("/auth/challenges", json=body)
+
+    def verify(self, challenge, sk=None):
+        signing_key = sk or self.sk
+        signature = BasicSchemeMPL.sign(signing_key, bytes.fromhex(challenge["messageHex"]))
+        return self.client.post("/auth/verify", json={
+            "challenge_id": challenge["challengeId"],
+            "public_key": bytes(signing_key.get_g1()).hex(),
+            "signature": bytes(signature).hex(),
+        })
+
+    def test_challenge_is_domain_chain_payload_and_address_bound(self):
+        response = self.challenge()
+        self.assertEqual(response.status_code, 200, response.text)
+        challenge = response.json()
+        self.assertEqual(challenge["algorithm"], "BLS12-381-BASIC")
+        self.assertEqual(bytes.fromhex(challenge["messageHex"]).decode(), challenge["message"])
+        self.assertIn('"chainId":406', challenge["message"])
+        self.assertIn('"networkId":1', challenge["message"])
+        self.assertIn('"domain":"test.canasino.invalid"', challenge["message"])
+        self.assertIn(f'"address":"{self.address}"', challenge["message"])
+        self.assertIn(f'"payloadHash":"{payload_hash(self.payload)}"', challenge["message"])
+
+    def test_valid_proof_issues_one_use_payload_scoped_grant(self):
+        challenge = self.challenge().json()
+        verified = self.verify(challenge)
+        self.assertEqual(verified.status_code, 200, verified.text)
+        grant = verified.json()["grant"]
+        authorizer = self.app.state.wallet_authorizer
+        authorizer.consume_grant(
+            grant, address=self.address, action="join_room",
+            resource=f"round:{'ab' * 8}", payload=self.payload,
+        )
+        with self.assertRaises(AuthError):
+            authorizer.consume_grant(
+                grant, address=self.address, action="join_room",
+                resource=f"round:{'ab' * 8}", payload=self.payload,
+            )
+
+    def test_challenge_cannot_be_replayed(self):
+        challenge = self.challenge().json()
+        self.assertEqual(self.verify(challenge).status_code, 200)
+        replay = self.verify(challenge)
+        self.assertEqual(replay.status_code, 401)
+        self.assertEqual(replay.json()["code"], "invalid_wallet_proof")
+
+    def test_concurrent_verification_has_exactly_one_winner(self):
+        challenge = self.challenge().json()
+        signature = bytes(BasicSchemeMPL.sign(self.sk, bytes.fromhex(challenge["messageHex"]))).hex()
+
+        def verify(_):
+            try:
+                return self.app.state.wallet_authorizer.verify_challenge(
+                    challenge_id=challenge["challengeId"], public_key=self.public_key.hex(),
+                    signature=signature,
+                )
+            except AuthError:
+                return None
+
+        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
+            results = list(pool.map(verify, range(16)))
+        self.assertEqual(sum(result is not None for result in results), 1)
+
+    def test_wrong_key_cannot_claim_an_address(self):
+        challenge = self.challenge().json()
+        other = BasicSchemeMPL.key_gen(b"another-wallet-test-seed-value!!")
+        response = self.verify(challenge, other)
+        self.assertEqual(response.status_code, 401)
+
+    def test_payload_resource_or_action_mismatch_does_not_consume_grant(self):
+        challenge = self.challenge().json()
+        grant = self.verify(challenge).json()["grant"]
+        authorizer = self.app.state.wallet_authorizer
+        for values in [
+            {"payload": {"amount": 101, "roundId": "ab" * 8}},
+            {"resource": "round:wrong"},
+            {"action": "roulette_bet"},
+        ]:
+            attempt = {
+                "address": self.address, "action": "join_room",
+                "resource": f"round:{'ab' * 8}", "payload": self.payload,
+            }
+            attempt.update(values)
+            with self.assertRaises(AuthError):
+                authorizer.consume_grant(grant, **attempt)
+        authorizer.consume_grant(grant, address=self.address, action="join_room",
+                                 resource=f"round:{'ab' * 8}", payload=self.payload)
+
+    def test_expired_challenge_and_grant_are_rejected(self):
+        clock = [1_000]
+        authorizer = WalletAuthorizer(
+            self.store, domain="test.canasino.invalid", chain_id=406, network_id=1,
+            challenge_ttl=2, grant_ttl=2, clock=lambda: clock[0],
+        )
+        challenge = authorizer.create_challenge(
+            address=self.address, action="join_room", resource="round:test",
+            body_hash=payload_hash(self.payload),
+        )
+        clock[0] = 1_003
+        signature = BasicSchemeMPL.sign(self.sk, bytes.fromhex(challenge.message_hex))
+        with self.assertRaises(AuthError):
+            authorizer.verify_challenge(
+                challenge_id=challenge.challenge_id, public_key=self.public_key.hex(),
+                signature=bytes(signature).hex(),
+            )
+
+    def test_grant_and_operation_creation_are_atomic_and_idempotent(self):
+        challenge = self.challenge().json()
+        grant = self.verify(challenge).json()["grant"]
+        operation_id = str(uuid.uuid4())
+        tx_hash = "12" * 32
+        authorizer = self.app.state.wallet_authorizer
+        first = authorizer.authorize_operation(
+            grant, operation_id=operation_id, address=self.address, action="join_room",
+            resource=f"round:{'ab' * 8}", payload=self.payload, tx_hash=tx_hash,
+        )
+        self.assertEqual(first["state"], "AUTHORIZED")
+        retry = authorizer.authorize_operation(
+            "already-consumed", operation_id=operation_id, address=self.address,
+            action="join_room", resource=f"round:{'ab' * 8}", payload=self.payload,
+            tx_hash=tx_hash,
+        )
+        self.assertEqual(retry["operation_id"], operation_id)
+        with self.assertRaises(AuthError) as conflict:
+            authorizer.authorize_operation(
+                "anything", operation_id=operation_id, address=self.address,
+                action="join_room", resource=f"round:{'ab' * 8}",
+                payload={**self.payload, "amount": 101}, tx_hash=tx_hash,
+            )
+        self.assertEqual(conflict.exception.status_code, 409)
+
+        self.assertTrue(self.store.transition_operation(operation_id, "AUTHORIZED", "PENDING", 1_001))
+        self.assertTrue(self.store.transition_operation(operation_id, "PENDING", "FINALIZED", 1_002, 55))
+        self.assertTrue(self.store.transition_operation(operation_id, "FINALIZED", "APPLIED", 1_003, 55))
+        self.assertEqual(self.store.get_operation(operation_id)["state"], "APPLIED")
+        self.assertEqual(self.store.reconcilable_operations(), [])
+
+    def test_challenge_rate_limit_is_persistent(self):
+        for _ in range(5):
+            self.assertEqual(self.challenge().status_code, 200)
+        response = self.challenge()
+        self.assertEqual(response.status_code, 429)
+        self.assertEqual(response.json()["code"], "rate_limited")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_wallet_registration.py b/tests/test_wallet_registration.py
new file mode 100644
index 0000000..574ccc2
--- /dev/null
+++ b/tests/test_wallet_registration.py
@@ -0,0 +1,164 @@
+import hashlib
+import os
+import unittest
+import uuid
+from unittest.mock import patch
+
+from blspy import BasicSchemeMPL
+from fastapi.testclient import TestClient
+
+from gameserver.app import create_app
+from gameserver.auth import payload_hash
+from gameserver.chain import ReceiptInvalid, ReceiptPending
+from gameserver.db import Store
+from tests.fakes import FakeBridge
+
+
+class ReceiptBridge(FakeBridge):
+    def __init__(self):
+        super().__init__()
+        self.receipt_mode = "valid"
+        self.receipt_calls = []
+
+    def transaction_receipt(self, tx_hash, *, sender, message_type, expected_fields=None):
+        self.receipt_calls.append({
+            "tx_hash": tx_hash, "sender": sender, "message_type": message_type,
+            "expected_fields": expected_fields,
+        })
+        if self.receipt_mode == "pending":
+            raise ReceiptPending("needs another confirmation")
+        if self.receipt_mode == "invalid":
+            raise ReceiptInvalid("transaction signer mismatch")
+        return {"height": 777, "confirmations": 2}
+
+
+class WalletRegistrationTests(unittest.TestCase):
+    def setUp(self):
+        env = patch.dict(os.environ, {
+            "CASINO_ADMIN_TOKEN": "wallet-registration-operator",
+            "CASINO_AUTH_DOMAIN": "test.canasino.invalid",
+        })
+        env.start()
+        self.addCleanup(env.stop)
+        self.store = Store(":memory:")
+        self.bridge = ReceiptBridge()
+        self.app = create_app(self.bridge, self.store)
+        self.client = TestClient(self.app)
+        self.addCleanup(self.client.close)
+        self.addCleanup(self.store.close)
+        self.admin = {"Authorization": "Bearer wallet-registration-operator"}
+        self.sk = BasicSchemeMPL.key_gen(b"wallet-registration-seed-value-32")
+        self.public_key = bytes(self.sk.get_g1())
+        self.address = hashlib.sha256(self.public_key).digest()[:20].hex()
+
+    def grant(self, action, resource, body):
+        challenge_response = self.client.post("/auth/challenges", json={
+            "address": self.address, "action": action, "resource": resource,
+            "payload_hash": payload_hash(body),
+        })
+        self.assertEqual(challenge_response.status_code, 200, challenge_response.text)
+        challenge = challenge_response.json()
+        signature = BasicSchemeMPL.sign(self.sk, bytes.fromhex(challenge["messageHex"]))
+        response = self.client.post("/auth/verify", json={
+            "challenge_id": challenge["challengeId"], "public_key": self.public_key.hex(),
+            "signature": bytes(signature).hex(),
+        })
+        self.assertEqual(response.status_code, 200, response.text)
+        return response.json()["grant"]
+
+    def open_round(self, game):
+        if game == "bingo":
+            response = self.client.post("/rounds", headers=self.admin, json={"room": "classic"})
+        else:
+            response = self.client.post(f"/{game}/rounds", headers=self.admin, json={})
+        self.assertEqual(response.status_code, 200, response.text)
+        return response.json()["roundId"]
+
+    def case(self, game, tx_byte="12"):
+        rid = self.open_round(game)
+        operation_id = str(uuid.uuid4())
+        body = {"address": self.address, "operation_id": operation_id, "tx_hash": tx_byte * 32}
+        if game == "bingo":
+            body["num_cards"] = 2
+            path, action, resource = f"/rounds/{rid}/register", "join_room", f"round:{rid}"
+        elif game == "roulette":
+            body.update({"bet_type": "red", "bet_number": 0, "amount": 1_000_000})
+            path, action, resource = (f"/roulette/rounds/{rid}/register", "roulette_bet",
+                                      f"roulette-round:{rid}")
+        else:
+            path = f"/{game}/rounds/{rid}/register"
+            action = f"join_{game}"
+            resource = f"{game}-round:{rid}"
+        return path, action, resource, body
+
+    def test_all_four_wallet_registrations_require_exact_receipt_and_become_applied(self):
+        for index, game in enumerate(("bingo", "roulette", "domino", "poker"), start=1):
+            with self.subTest(game=game):
+                path, action, resource, body = self.case(game, f"{index:02x}")
+                grant = self.grant(action, resource, body)
+                response = self.client.post(
+                    path, json=body, headers={"Authorization": f"Canasino-Wallet {grant}"},
+                )
+                self.assertEqual(response.status_code, 200, response.text)
+                self.assertEqual(response.json()["operationState"], "APPLIED")
+                self.assertEqual(response.json()["receiptHeight"], 777)
+                receipt_call_count = len(self.bridge.receipt_calls)
+                replay = self.client.post(
+                    path, json=body, headers={"Authorization": "Canasino-Wallet consumed"},
+                )
+                self.assertEqual(replay.status_code, 200, replay.text)
+                self.assertEqual(replay.json()["operationState"], "APPLIED")
+                self.assertEqual(len(self.bridge.receipt_calls), receipt_call_count)
+
+    def test_pending_receipt_resumes_with_consumed_grant(self):
+        path, action, resource, body = self.case("bingo")
+        grant = self.grant(action, resource, body)
+        self.bridge.receipt_mode = "pending"
+        pending = self.client.post(
+            path, json=body, headers={"Authorization": f"Canasino-Wallet {grant}"},
+        )
+        self.assertEqual(pending.status_code, 425, pending.text)
+        self.assertEqual(self.store.get_operation(body["operation_id"])["state"], "PENDING")
+        self.bridge.receipt_mode = "valid"
+        resumed = self.client.post(
+            path, json=body, headers={"Authorization": "Canasino-Wallet already-consumed"},
+        )
+        self.assertEqual(resumed.status_code, 200, resumed.text)
+        self.assertEqual(resumed.json()["operationState"], "APPLIED")
+
+    def test_invalid_receipt_is_permanently_rejected(self):
+        path, action, resource, body = self.case("roulette")
+        grant = self.grant(action, resource, body)
+        self.bridge.receipt_mode = "invalid"
+        rejected = self.client.post(
+            path, json=body, headers={"Authorization": f"Canasino-Wallet {grant}"},
+        )
+        self.assertEqual(rejected.status_code, 422, rejected.text)
+        self.assertEqual(self.store.get_operation(body["operation_id"])["state"], "REJECTED")
+        replay = self.client.post(
+            path, json=body, headers={"Authorization": "Canasino-Wallet consumed"},
+        )
+        self.assertEqual(replay.status_code, 409, replay.text)
+
+    def test_one_chain_transaction_cannot_back_two_operations(self):
+        path, action, resource, first_body = self.case("domino")
+        first_grant = self.grant(action, resource, first_body)
+        first = self.client.post(
+            path, json=first_body, headers={"Authorization": f"Canasino-Wallet {first_grant}"},
+        )
+        self.assertEqual(first.status_code, 200, first.text)
+        second_body = {**first_body, "operation_id": str(uuid.uuid4())}
+        second_grant = self.grant(action, resource, second_body)
+        second = self.client.post(
+            path, json=second_body, headers={"Authorization": f"Canasino-Wallet {second_grant}"},
+        )
+        self.assertEqual(second.status_code, 409, second.text)
+        self.assertEqual(second.json()["code"], "operation_conflict")
+
+    def test_wallet_scheme_is_scoped_to_registration_routes(self):
+        headers = {"Authorization": "Canasino-Wallet anything"}
+        self.assertEqual(self.client.post("/rounds", headers=headers, json={"room": "classic"}).status_code, 401)
+
+
+if __name__ == "__main__":
+    unittest.main()
