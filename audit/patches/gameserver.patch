diff --git a/tests/test_audit_security.py b/tests/test_audit_security.py
new file mode 100644
index 0000000..408804e
--- /dev/null
+++ b/tests/test_audit_security.py
@@ -0,0 +1,76 @@
+import concurrent.futures
+import os
+import unittest
+from fastapi.testclient import TestClient
+from starlette.websockets import WebSocketDisconnect
+from gameserver.app import create_app
+from gameserver.db import Store
+from tests.fakes import FakeBridge
+from unittest.mock import patch
+
+
+class SecurityBoundaryTests(unittest.TestCase):
+    def setUp(self):
+        env = patch.dict(os.environ, {'CASINO_ADMIN_TOKEN': 'audit-test-operator'})
+        env.start()
+        self.addCleanup(env.stop)
+        self.store = Store(':memory:')
+        self.bridge = FakeBridge()
+        self.app = create_app(self.bridge, self.store)
+        self.client = TestClient(self.app)
+
+    def tearDown(self):
+        self.client.close()
+        self.store.close()
+
+    def test_every_mutating_endpoint_is_denied_without_operator(self):
+        for route in self.app.routes:
+            if 'POST' not in getattr(route, 'methods', set()):
+                continue
+            if route.path in ('/auth/challenges', '/auth/verify'):
+                continue
+            path = route.path.replace('{rid}', 'ab'*8).replace('{address}', 'ab'*20)
+            with self.subTest(path=path):
+                response = self.client.post(path, json={'address':'ab'*20,'action':'fold','amount':1})
+                self.assertEqual(response.status_code, 401)
+        self.assertEqual(self.bridge.balances, {})
+
+    def test_private_hands_and_cards_cannot_be_read_by_address(self):
+        for path in ['/rounds/a/card','/poker/rounds/a/hand','/domino/rounds/a/hand']:
+            self.assertEqual(self.client.get(path, params={'address':'ab'*20}).status_code, 401)
+
+    def test_sockets_cannot_drive_settlement_anonymously(self):
+        for path in ['/ws/rounds/a','/ws/roulette/a','/ws/domino/a','/ws/poker/a','/ws/rounds/a/chat']:
+            with self.assertRaises(WebSocketDisconnect):
+                with self.client.websocket_connect(path):
+                    self.fail('anonymous connection accepted')
+
+    def test_read_only_capabilities_and_operator_validation(self):
+        self.assertFalse(self.client.get('/capabilities').json()['real_money_enabled'])
+        self.assertEqual(self.client.get('/rooms').status_code,200)
+        headers={'Authorization':'Bearer audit-test-operator'}
+        response=self.client.post('/rounds',headers=headers,json={'room':'classic'})
+        self.assertEqual(response.status_code,200)
+        self.assertIsNone(self.client.get('/rounds/'+response.json()['roundId']+'/proof').json()['seed'])
+        self.assertEqual(self.client.post('/rounds',headers=headers,content='a'*17000).status_code,413)
+        self.assertEqual(self.client.post('/rounds',headers={'Authorization':'Bearer wrong'},json={'room':'classic'}).status_code,401)
+        self.assertEqual(self.client.get('/leaderboard?limit=100000').status_code,422)
+
+    def test_settlement_is_immutable_and_counted_once_concurrently(self):
+        def record(_):
+            self.store.record_settle('round','classic',100,1000,{'a':90},'tx', ['a'])
+        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
+            list(pool.map(record,range(32)))
+        self.store.record_settle('round','classic',100,1000,{'a':999},'other', ['a'])
+        self.assertEqual(self.store.stats_for('a')['gamesPlayed'],1)
+        self.assertEqual(self.store.stats_for('a')['totalWon'],90)
+        self.assertEqual(self.store.history_for('a')[0]['txHash'],'tx')
+
+    def test_failed_stats_update_rolls_back_history(self):
+        self.store._conn.execute("CREATE TRIGGER fail_stats BEFORE INSERT ON player_stats BEGIN SELECT RAISE(ABORT, 'test'); END")
+        with self.assertRaises(Exception):
+            self.store.record_settle('round','classic',100,1000,{'a':90},'tx')
+        self.assertEqual(self.store.history_for('a'),[])
+
+if __name__ == '__main__':
+    unittest.main()
