+"""Shared game-server side of the fair-randomness-v2 close lifecycle.
+
+The plugin remains authoritative: it consumes its FSM-fed entropy ledger and
+will reject an early or mismatched settlement.  This module independently
+reconstructs the same seed from public finalized blocks so the UI/game engine
+cannot diverge from the outcome the plugin pays.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+
+from engine.rng import derive_seed
+
+
+ENTROPY_DELAY_BLOCKS = 8
+ENTROPY_WINDOW_BLOCKS = 8
+RNG_V2_ENTROPY_DOMAIN = b"CANASINO-RNG-V2-ENTROPY"
+RNG_V2_SEED_DOMAIN = b"CANASINO-RNG-V2"
+
+# Must match the plugin's CANASINO_REQUIRE_CONSENSUS_VDF gate: when set, a round
+# is only derived/settled once every block in its window carried a consensus VDF
+# output, so the game-server never asks the plugin to settle a window the plugin
+# will reject. Off by default (the valueless testnet's sub-second phases still
+# produce VDFs, but production is where this is enforced).
+REQUIRE_CONSENSUS_VDF = os.environ.get(
+    "CANASINO_REQUIRE_CONSENSUS_VDF", "").strip().lower() in ("1", "true", "yes")
+# The default Canopy schedule is about 20 seconds per block. A close at H must
+# wait through H+16, so 150 seconds can never cover a healthy production node.
+DEFAULT_ENTROPY_WAIT_TIMEOUT = 900.0
+
+
+def entropy_bounds(close_height: int) -> tuple[int, int]:
+    start = close_height + ENTROPY_DELAY_BLOCKS
+    return start, start + ENTROPY_WINDOW_BLOCKS - 1
+
+
+def derive_final_seed(bridge, operator_secret: bytes, round_id: bytes,
+                      entropy_start: int, entropy_end: int) -> bytes:
+    """Reconstruct the exact seed the plugin replays the outcome from.
+
+    This MUST match the plugin byte for byte (contract/contract.py):
+      * per height, the ledger value is `block_hash || vdf_output` (the VDF
+        empty when that block carried none) -- `bridge.consensus_entropy_value`;
+      * fold  = SHA256(RNG_V2_ENTROPY_DOMAIN || v[start] || ... || v[end])
+                -- raw concatenation of those ledger values;
+      * seed  = derive_seed(RNG_V2_SEED_DOMAIN, operator_secret, fold, round_id)
+                -- derive_seed() length-prefixes every part with a 4-byte
+                big-endian length, so a raw concatenation here would diverge
+                from the outcome the plugin actually pays.
+    """
+    if entropy_end < entropy_start:
+        raise ValueError("invalid entropy window")
+    entropy_hash = hashlib.sha256()
+    entropy_hash.update(RNG_V2_ENTROPY_DOMAIN)
+    for height in range(entropy_start, entropy_end + 1):
+        value = bridge.consensus_entropy_value(height)
+        if REQUIRE_CONSENSUS_VDF and len(value) <= 32:
+            raise ValueError(
+                f"block {height} carried no consensus VDF output "
+                "(CANASINO_REQUIRE_CONSENSUS_VDF)"
+            )
+        entropy_hash.update(value)
+    return derive_seed(
+        RNG_V2_SEED_DOMAIN, operator_secret, entropy_hash.digest(), round_id,
+    )
+
+
+def wait_and_derive(round_state, bridge, timeout: float = 150.0) -> bytes:
+    if round_state.status != "closed" or not round_state.entropy_end:
+        raise ValueError("round must be closed before deriving entropy")
+    # The plugin records a block's hash when BeginBlock receives its successor,
+    # hence settlement is legal only strictly after entropy_end.
+    bridge.wait_for_height(round_state.entropy_end + 1, timeout=timeout)
+    seed = derive_final_seed(
+        bridge, round_state.seed, round_state.round_id,
+        round_state.entropy_start, round_state.entropy_end,
+    )
+    round_state.outcome_seed = seed
+    return seed
