+                raise HTTPException(
+                    status_code=422,
+                    detail={"code": "receipt_invalid", "operationId": operation["operation_id"],
+                            "message": str(exc)},
+                ) from exc
+            store.transition_operation(
+                operation["operation_id"], operation["state"], "FINALIZED", int(time.time()),
+                receipt_height=receipt["height"],
+            )
+            operation = store.get_operation(operation["operation_id"])
+
+        if operation and operation["state"] == "FINALIZED":
+            apply()
+            store.transition_operation(
+                operation["operation_id"], "FINALIZED", "APPLIED", int(time.time()),
+                receipt_height=operation["receipt_height"],
+            )
+            operation = store.get_operation(operation["operation_id"])
+        return operation
+
+    def operation_response(operation: dict | None) -> dict:
+        if operation is None:
+            return {}
+        return {"operationId": operation["operation_id"], "operationState": operation["state"],
+                "txHash": operation["tx_hash"], "receiptHeight": operation["receipt_height"]}
+
+    def authorize_wallet_action(authorization: str | None, *, body: BaseModel,
+                                address: str, action: str, resource: str) -> bool:
+        """Consume a one-use wallet grant for an off-chain ordered action.
+
+        Returns False only for the trusted operator recovery path. Browser
+        actions must bind a UUID, sequence, prior-state hash and the complete
+        request body into the signed CANASINO-AUTH-V1 challenge.
+        """
+        operator_header = f"Bearer {admin_token}"
+        if authorization and secrets.compare_digest(authorization.encode(), operator_header.encode()):
+            return False
+        prefix = "Canasino-Wallet "
+        if not authorization or not authorization.startswith(prefix):
+            raise AuthError("wallet authorization grant required")
+        token = authorization[len(prefix):]
+        operation_id = getattr(body, "operation_id", None)
+        sequence = getattr(body, "sequence", None)
+        state_hash = getattr(body, "state_hash", None)
+        if operation_id is None or sequence is None or state_hash is None:
+            raise AuthError("operation_id, sequence and state_hash are required", 422, "invalid_request")
+        try:
+            uuid.UUID(operation_id)
+        except (TypeError, ValueError) as exc:
+            raise AuthError("invalid operation id", 422, "invalid_request") from exc
+        wallet_authorizer.consume_grant(
+            token, address=address, action=action, resource=resource,
+            payload=body.model_dump(exclude_none=True),
+        )
+        return True
+
+    @app.exception_handler(KeyError)
+    async def missing_resource(request, exc):
+        return JSONResponse({"detail": "Resource not found"}, status_code=404)
+
+    @app.exception_handler(ValueError)
+    async def invalid_request(request, exc):
+        return JSONResponse({"detail": "Invalid request or game state"}, status_code=422)
+
+    @app.exception_handler(AuthError)
+    async def invalid_wallet_proof(request, exc: AuthError):
+        return JSONResponse({"detail": str(exc), "code": exc.code}, status_code=exc.status_code,
+                            headers={"Cache-Control": "no-store"})
+
+    @app.post("/auth/challenges")
+    def create_wallet_challenge(body: AuthChallengeBody):
+        challenge = wallet_authorizer.create_challenge(
+            address=body.address, action=body.action, resource=body.resource,
+            body_hash=body.payload_hash,
+        )
+        return {
+            "challengeId": challenge.challenge_id,
+            "message": challenge.message,
+            "messageHex": challenge.message_hex,
+            "expiresAt": challenge.expires_at,
+            "algorithm": "BLS12-381-BASIC",
+        }
+
+    @app.post("/auth/verify")
+    def verify_wallet_challenge(body: AuthVerifyBody):
+        token = wallet_authorizer.verify_challenge(
+            challenge_id=body.challenge_id,
+            public_key=body.public_key,
+            signature=body.signature,
+        )
+        return {"grant": token, "scheme": "Canasino-Wallet", "singleUse": True}
+
+    @app.get("/capabilities")
+    def capabilities():
