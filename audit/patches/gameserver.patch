+"""Wallet-bound, one-use authorization challenges for economic operations.
+
+FleetWallet must sign the exact UTF-8 bytes returned in ``messageHex`` using
+Canopy's BLS12-381 Basic scheme.  A successful proof yields a short-lived,
+single-use grant bound to one action, resource and canonical payload hash.
+The grant is not a login cookie and cannot authorize a different operation.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import secrets
+import time
+import uuid
+from dataclasses import dataclass
+from typing import Any, Callable
+
+from blspy import BasicSchemeMPL, G1Element, G2Element
+
+from .db import Store
+
+AUTH_VERSION = "CANASINO-AUTH-V1"
+ALLOWED_ACTIONS = frozenset({
+    "join_room", "roulette_bet", "join_domino", "domino_move",
+    "join_poker", "poker_action", "read_private_state",
+})
+
+
+class AuthError(ValueError):
+    def __init__(self, message: str, status_code: int = 401, code: str = "invalid_wallet_proof"):
+        super().__init__(message)
+        self.status_code = status_code
+        self.code = code
+
+
+def canonical_json(value: Any) -> bytes:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("utf-8")
+
+
+def payload_hash(payload: Any) -> str:
+    return hashlib.sha256(canonical_json(payload)).hexdigest()
+
+
+def _decode_hex(value: str, expected_bytes: int, label: str) -> bytes:
+    if not isinstance(value, str) or len(value) != expected_bytes * 2:
+        raise AuthError(f"invalid {label}")
+    try:
+        return bytes.fromhex(value)
+    except ValueError as exc:
+        raise AuthError(f"invalid {label}") from exc
+
+
+@dataclass(frozen=True)
+class Challenge:
+    challenge_id: str
+    message: str
+    message_hex: str
+    expires_at: int
+
+
+class WalletAuthorizer:
+    def __init__(
+        self,
+        store: Store,
+        *,
+        domain: str,
+        chain_id: int,
+        network_id: int,
+        challenge_ttl: int = 120,
+        grant_ttl: int = 90,
+        clock: Callable[[], float] = time.time,
+    ):
+        if not domain or len(domain) > 253:
+            raise ValueError("CASINO_AUTH_DOMAIN must be a valid non-empty domain")
+        self.store = store
+        self.domain = domain.lower()
+        self.chain_id = chain_id
+        self.network_id = network_id
+        self.challenge_ttl = challenge_ttl
+        self.grant_ttl = grant_ttl
+        self.clock = clock
+
+    def create_challenge(self, *, address: str, action: str, resource: str, body_hash: str) -> Challenge:
+        address = address.lower()
+        if len(address) != 40:
+            raise AuthError("invalid wallet address", 422, "invalid_request")
+        _decode_hex(address, 20, "wallet address")
+        if action not in ALLOWED_ACTIONS:
+            raise AuthError("unsupported authorization action", 422, "invalid_request")
+        if not resource or len(resource) > 256:
+            raise AuthError("invalid authorization resource", 422, "invalid_request")
+        _decode_hex(body_hash.lower(), 32, "payload hash")
+
+        now = int(self.clock())
+        if self.store.count_recent_auth_challenges(address, now - 60) >= 5:
+            raise AuthError("too many outstanding wallet challenges", 429, "rate_limited")
+        challenge_id = str(uuid.uuid4())
+        expires_at = now + self.challenge_ttl
+        fields = {
+            "action": action,
+            "address": address,
+            "challengeId": challenge_id,
+            "chainId": self.chain_id,
+            "domain": self.domain,
+            "expiresAt": expires_at,
+            "issuedAt": now,
+            "networkId": self.network_id,
+            "nonce": secrets.token_hex(32),
+            "payloadHash": body_hash.lower(),
+            "resource": resource,
+            "version": AUTH_VERSION,
+        }
+        message_bytes = canonical_json(fields)
+        message = message_bytes.decode("utf-8")
+        self.store.create_auth_challenge(
+            challenge_id, address, action, resource, body_hash.lower(), message, now, expires_at,
+        )
+        return Challenge(challenge_id, message, message_bytes.hex(), expires_at)
+
+    def verify_challenge(self, *, challenge_id: str, public_key: str, signature: str) -> str:
+        record = self.store.get_auth_challenge(challenge_id)
+        now = int(self.clock())
+        if not record or record["used_at"] is not None or record["expires_at"] < now:
+            raise AuthError("wallet challenge is missing, expired or already used")
+
+        public_key_bytes = _decode_hex(public_key.lower(), 48, "public key")
+        signature_bytes = _decode_hex(signature.lower(), 96, "signature")
+        derived_address = hashlib.sha256(public_key_bytes).digest()[:20].hex()
+        if not secrets.compare_digest(derived_address, record["address"]):
+            raise AuthError("public key does not control the requested address")
+        try:
+            valid = BasicSchemeMPL.verify(
+                G1Element.from_bytes(public_key_bytes),
+                record["message"].encode("utf-8"),
+                G2Element.from_bytes(signature_bytes),
+            )
+        except (ValueError, RuntimeError) as exc:
+            raise AuthError("invalid wallet signature") from exc
+        if not valid:
+            raise AuthError("invalid wallet signature")
+        if not self.store.consume_auth_challenge(challenge_id, now):
+            raise AuthError("wallet challenge is missing, expired or already used")
+
+        raw_token = secrets.token_urlsafe(32)
+        token_hash = hashlib.sha256(raw_token.encode("ascii")).hexdigest()
+        self.store.create_wallet_grant(
+            token_hash, record["address"], record["action"], record["resource"],
+            record["payload_hash"], now, now + self.grant_ttl,
+        )
+        return raw_token
+
+    def consume_grant(self, token: str, *, address: str, action: str, resource: str, payload: Any) -> None:
+        if not token or len(token) > 256:
+            raise AuthError("wallet authorization grant required")
+        token_hash = hashlib.sha256(token.encode("ascii", "strict")).hexdigest()
+        accepted = self.store.consume_wallet_grant(
+            token_hash, address.lower(), action, resource, payload_hash(payload), int(self.clock()),
+        )
+        if not accepted:
+            raise AuthError("wallet authorization grant is invalid, expired, used or payload-mismatched")
+
+    def authorize_operation(self, token: str, *, operation_id: str, address: str,
+                            action: str, resource: str, payload: Any, tx_hash: str) -> dict:
+        try:
+            uuid.UUID(operation_id)
+        except (TypeError, ValueError) as exc:
+            raise AuthError("invalid operation id", 422, "invalid_request") from exc
+        normalized_tx_hash = tx_hash.removeprefix("0x").lower()
+        _decode_hex(normalized_tx_hash, 32, "transaction hash")
+        if not token or len(token) > 256:
+            raise AuthError("wallet authorization grant required")
+        token_hash = hashlib.sha256(token.encode("ascii", "strict")).hexdigest()
+        try:
+            operation = self.store.authorize_operation(
+                token_hash, operation_id, address.lower(), action, resource,
+                payload_hash(payload), normalized_tx_hash, int(self.clock()),
+            )
+        except ValueError as exc:
+            raise AuthError(str(exc), 409, "operation_conflict") from exc
+        if not operation:
+            raise AuthError("wallet authorization grant is invalid, expired, used or payload-mismatched")
+        return operation
