+++ b/tests/test_chain_outbox.py
@@ -0,0 +1,76 @@
+import json
+import unittest
+
+from gameserver.chain import CanopyBridge, Key
+from gameserver.db import Store
+
+
+TX_HASH = "cd" * 32
+SIGNER = Key(address="12" * 20, public_key="34" * 48, private_key="56" * 32)
+
+
+class OutboxBridge(CanopyBridge):
+    def __init__(self, store, fail_submit=False):
+        super().__init__(query_url="http://test")
+        self.store = store
+        self.fail_submit = fail_submit
+        self.built = 0
+        self.posts = []
+
+    def _signed_transaction(self, signer, msg_type, msg_bytes):
+        self.built += 1
+        return {"type": msg_type, "msgBytes": msg_bytes.hex(), "stable": True}, TX_HASH
+
+    def _post(self, url, body):
+        self.posts.append((url, body))
+        if self.fail_submit:
+            raise TimeoutError("response lost after acceptance")
+        return json.dumps(TX_HASH)
+
+    def transaction_receipt(self, tx_hash, *, sender, message_type, expected_fields=None):
+        self.assertions = (tx_hash, sender, message_type)
+        return {"height": 88, "confirmations": 2}
+
+
+class ChainOutboxTests(unittest.TestCase):
+    def setUp(self):
+        self.store = Store(":memory:")
+        self.addCleanup(self.store.close)
+
+    def test_envelope_is_persisted_before_submit_and_reused_after_lost_response(self):
+        first = OutboxBridge(self.store, fail_submit=True)
+        tx_hash = first.submit(SIGNER, "send", b"payload", operation_id="economic-op-1")
+        self.assertEqual(tx_hash, TX_HASH)
+        saved = self.store.get_chain_submission("economic-op-1")
+        self.assertEqual(saved["state"], "SUBMITTED")
+        self.assertEqual(json.loads(saved["tx_json"]), first.posts[0][1])
+
+        restarted = OutboxBridge(self.store)
+        recovered = restarted.submit_and_wait(
+            SIGNER, "send", b"payload", timeout=0.1, operation_id="economic-op-1",
+        )
+        self.assertEqual(recovered, TX_HASH)
+        self.assertEqual(restarted.built, 0, "restart must reuse the exact signed envelope")
+        finalized = self.store.get_chain_submission("economic-op-1")
+        self.assertEqual(finalized["state"], "FINALIZED")
+        self.assertEqual(finalized["receipt_height"], 88)
+
+    def test_operation_id_cannot_be_rebound_to_another_payload(self):
+        bridge = OutboxBridge(self.store)
+        bridge.submit(SIGNER, "send", b"first", operation_id="economic-op-2")
+        with self.assertRaises(ValueError):
+            bridge.submit(SIGNER, "send", b"second", operation_id="economic-op-2")
+
+    def test_finalized_submission_returns_without_network_or_resigning(self):
+        bridge = OutboxBridge(self.store)
+        bridge.submit_and_wait(SIGNER, "send", b"payload", timeout=0.1,
+                               operation_id="economic-op-3")
+        restarted = OutboxBridge(self.store, fail_submit=True)
+        self.assertEqual(restarted.submit(
+            SIGNER, "send", b"payload", operation_id="economic-op-3"), TX_HASH)
+        self.assertEqual(restarted.built, 0)
+        self.assertEqual(restarted.posts, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
