@@ -0,0 +1,57 @@
+import os
+import unittest
+from unittest.mock import patch
+
+from blspy import BasicSchemeMPL
+
+from gameserver.app import create_app
+from gameserver.chain import CanopyBridge, Key
+
+
+class RecordingSigner:
+    def __init__(self, private_key, invalid=False):
+        self.private_key = private_key
+        self.invalid = invalid
+        self.messages = []
+
+    def sign(self, signer, message):
+        self.messages.append((signer.address, message))
+        if self.invalid:
+            return bytes(96)
+        return bytes(BasicSchemeMPL.sign(self.private_key, message))
+
+
+class ExternalSignerBoundaryTests(unittest.TestCase):
+    def setUp(self):
+        self.private_key = BasicSchemeMPL.key_gen(b"external-signer-test-seed-material")
+        public_key = bytes(self.private_key.get_g1())
+        import hashlib
+        self.key = Key(
+            address=hashlib.sha256(public_key).digest()[:20].hex(),
+            public_key=public_key.hex(), private_key=None,
+        )
+
+    def test_bridge_accepts_a_verified_external_signature_without_private_key(self):
+        signer = RecordingSigner(self.private_key)
+        bridge = CanopyBridge(signer=signer)
+        bridge.height = lambda: 123
+        wire, tx_hash = bridge._signed_transaction(self.key, "send", b"exact payload")
+        self.assertEqual(len(signer.messages), 1)
+        self.assertEqual(wire["signature"]["publicKey"], self.key.public_key)
+        self.assertEqual(len(wire["signature"]["signature"]), 192)
+        self.assertEqual(len(tx_hash), 64)
+
+    def test_bridge_rejects_an_invalid_external_signature(self):
+        bridge = CanopyBridge(signer=RecordingSigner(self.private_key, invalid=True))
+        bridge.height = lambda: 123
+        with self.assertRaisesRegex(RuntimeError, "invalid BLS signature"):
+            bridge._signed_transaction(self.key, "send", b"exact payload")
+
+    def test_real_money_mode_fails_closed_without_external_signer(self):
+        with patch.dict(os.environ, {"CASINO_REAL_MONEY_ENABLED": "true"}, clear=True):
+            with self.assertRaisesRegex(ValueError, "CASINO_SIGNER_SOCKET"):
+                create_app()
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_fair_randomness_v2.py b/tests/test_fair_randomness_v2.py
new file mode 100644
index 0000000..e011beb
--- /dev/null
+++ b/tests/test_fair_randomness_v2.py
@@ -0,0 +1,195 @@
+"""A.6.7 regression tests for the game-server close/entropy lifecycle."""
+
+import hashlib
+import os
+import tempfile
+import unittest
+import unittest.mock
+
+from engine import roulette as eroulette
+from gameserver.chain import Key
+from gameserver.db import Store
+from gameserver.domino_rooms import DominoManager
+import gameserver.fairness as fairness
+from gameserver.fairness import (
+    ENTROPY_DELAY_BLOCKS,
+    ENTROPY_WINDOW_BLOCKS,
+    RNG_V2_ENTROPY_DOMAIN,
+    RNG_V2_SEED_DOMAIN,
+    derive_final_seed,
+)
+from gameserver.poker_rooms import PokerManager
+from gameserver.rooms import RoomManager
+from gameserver.roulette_rooms import RouletteManager
+
+from .fakes import FakeBridge
+
+
+def _plugin_reference_seed(ledger_values, operator_secret, round_id):
+    """A second, independent implementation of the plugin's replay-seed layout
+    (contract/contract.py: fold_consensus_entropy + rng_v2_seed + derive_seed).
+    `ledger_values` are the per-height `hash || vdf_output` entries. If
+    derive_final_seed ever drifts from this, the game-server predicts a
+    different winner than the plugin pays -- the exact A.6.6 E2E flake."""
+    fold = hashlib.sha256()
+    fold.update(RNG_V2_ENTROPY_DOMAIN)
+    for v in ledger_values:
+        fold.update(v)
+    entropy = fold.digest()
+
+    seed = hashlib.sha256()
+    for part in (RNG_V2_SEED_DOMAIN, operator_secret, entropy, round_id):
+        seed.update(len(part).to_bytes(4, "big"))  # derive_seed length-prefixes
+        seed.update(part)
+    return seed.digest()
+
+
+class FairLifecycleTest(unittest.TestCase):
+    def setUp(self):
+        fd, self.path = tempfile.mkstemp(suffix=".db")
+        os.close(fd)
+        os.remove(self.path)
+        self.store = Store(self.path)
+        self.bridge = FakeBridge()
+        self.operator = self.bridge.new_key("operator")
+
+    def tearDown(self):
+        self.store.close()
+        for suffix in ("", "-wal", "-shm"):
+            path = self.path + suffix
+            if os.path.exists(path):
+                os.remove(path)
+
+    def assert_close_before_settle(self, game):
+        names = [call[0] for call in self.bridge.calls]
+        close_index = names.index(f"close_{game}")
+        settle_index = names.index(f"settle_{game}")
+        self.assertLess(close_index, settle_index)
+        settle_height = self.bridge.calls[settle_index][1]
+        self.assertGreaterEqual(settle_height, self.bridge.wait_targets[-1])
+
+    def test_bingo_closes_waits_and_settles_with_v2_seed(self):
+        manager = RoomManager(self.bridge, self.operator, self.store, operator_bond=77)
+        rnd = manager.create_round(entry_fee=100, room="classic")
+        address = manager.add_player(rnd.id_hex)
+        result = manager.settle(rnd.id_hex)
+
+        self.assertIn(address, result)
+        self.assertEqual(rnd.status, "settled")
+        self.assertNotEqual(rnd.seed, rnd.outcome_seed)
+        self.assertEqual(len(rnd.order), 75)
+        self.assert_close_before_settle("room")
+
+    def test_roulette_uses_exact_window_and_v2_spin(self):
+        manager = RouletteManager(self.bridge, self.operator, self.store, operator_bond=88)
+        rnd = manager.open_round(rake_bps=1000)
+        manager.place_bet(rnd.id_hex, "red", 0, 100)
+        result = manager.settle(rnd.id_hex)
+
+        expected_start = rnd.close_height + ENTROPY_DELAY_BLOCKS
+        expected_end = expected_start + ENTROPY_WINDOW_BLOCKS - 1
+        expected_seed = derive_final_seed(
+            self.bridge, rnd.seed, rnd.round_id, expected_start, expected_end,
+        )
+        self.assertEqual((rnd.entropy_start, rnd.entropy_end), (expected_start, expected_end))
+        self.assertEqual(self.bridge.wait_targets[-1], expected_end + 1)
+        self.assertEqual(rnd.outcome_seed, expected_seed)
+        self.assertEqual(result["spin"], eroulette.spin_number(expected_seed))
+        self.assert_close_before_settle("roulette")
+
+    def test_domino_and_poker_close_when_last_seat_arrives(self):
+        domino = DominoManager(self.bridge, self.operator, self.store, operator_bond=99)
+        dr = domino.open_round(100, 1000)
+        domino.join(dr.id_hex)
+        self.assertEqual(dr.status, "open")
+        domino.join(dr.id_hex)
+        self.assertEqual(dr.status, "closed")
+        self.assertTrue(dr.outcome_seed)
+        self.assertIn(dr.id_hex, domino.engines)
+
+        poker = PokerManager(self.bridge, self.operator, self.store, operator_bond=111)
+        pr = poker.open_round(10, 20, 1000, 1000)
+        poker.join(pr.id_hex)
+        self.assertEqual(pr.status, "open")
+        poker.join(pr.id_hex)
+        self.assertEqual(pr.status, "closed")
+        self.assertTrue(pr.outcome_seed)
+        self.assertIn(pr.id_hex, poker.engines)
+
+        names = [call[0] for call in self.bridge.calls]
+        self.assertIn("close_domino", names)
+        self.assertIn("close_poker", names)
+
+    def test_closed_round_reloads_without_losing_entropy_boundary(self):
+        manager = RouletteManager(self.bridge, self.operator, self.store)
+        rnd = manager.open_round(1000)
+        manager.place_bet(rnd.id_hex, "black", 0, 100)
+        manager.close_betting(rnd.id_hex)
+
+        reloaded = RouletteManager(self.bridge, self.operator, self.store).rounds[rnd.id_hex]
+        self.assertEqual(reloaded.status, "closed")
+        self.assertEqual(reloaded.close_height, rnd.close_height)
+        self.assertEqual(reloaded.entropy_end, rnd.entropy_end)
+        self.assertEqual(reloaded.close_tx_hash, rnd.close_tx_hash)
+
+    def test_derive_final_seed_matches_the_plugin_replay_layout(self):
+        bridge = FakeBridge()
+        operator_secret = bytes(range(32))
+        round_id = bytes.fromhex("0011223344556677")
+        start, end = 120, 127
+        window = [bridge.consensus_entropy_value(h) for h in range(start, end + 1)]
+        self.assertTrue(all(len(v) > 32 for v in window))  # every fake block has a VDF
+
+        got = derive_final_seed(bridge, operator_secret, round_id, start, end)
+        self.assertEqual(got, _plugin_reference_seed(window, operator_secret, round_id))
+        # a raw (non-length-prefixed) concatenation -- the old bug -- must differ
+        raw = hashlib.sha256(
+            RNG_V2_SEED_DOMAIN + operator_secret
+            + hashlib.sha256(RNG_V2_ENTROPY_DOMAIN + b"".join(window)).digest()
+            + round_id
+        ).digest()
+        self.assertNotEqual(got, raw)
+        # folding hash-only (dropping the VDF term) must also change the seed
+        self.assertNotEqual(
+            got, _plugin_reference_seed([v[:32] for v in window], operator_secret, round_id))
+
+    def test_require_vdf_rejects_a_window_missing_a_vdf(self):
+        bridge = FakeBridge()
+        bridge.vdf_missing_heights = {123}
+        with unittest.mock.patch.object(fairness, "REQUIRE_CONSENSUS_VDF", True):
+            with self.assertRaisesRegex(ValueError, "no consensus VDF"):
+                derive_final_seed(bridge, b"\x00" * 32, b"\x00" * 8, 120, 127)
+        # without the gate the same window derives fine (folds hash-only for 123)
+        self.assertTrue(derive_final_seed(bridge, b"\x00" * 32, b"\x00" * 8, 120, 127))
+
+    def test_derive_final_seed_frozen_known_answer(self):
+        """Pins the exact bytes (FakeBridge hash||vdf ledger values, all-zero
+        secret, round_id cafebabecafebabe, window 100..107) so the game-server
+        and the plugin cannot silently drift together. If the protocol changes
+        on purpose, update this vector and the plugin's replay layout in
+        lockstep."""
+        bridge = FakeBridge()
+        seed = derive_final_seed(
+            bridge, b"\x00" * 32, bytes.fromhex("cafebabecafebabe"), 100, 107,
+        )
+        self.assertEqual(
+            seed.hex(),
+            "6751060acdbb7ec87c459d3b119af4b77bb5f753c05bfad2656427a7165ee179",
+        )
+
+    def test_generated_proto_contains_all_close_messages_and_bonds(self):
+        from gameserver import tx_pb2
+
+        fixtures = (
+            (tx_pb2.MessageOpenRoom, tx_pb2.MessageCloseRoom),
+            (tx_pb2.MessageOpenRoulette, tx_pb2.MessageCloseRoulette),
+            (tx_pb2.MessageOpenDomino, tx_pb2.MessageCloseDomino),
+            (tx_pb2.MessageOpenPoker, tx_pb2.MessageClosePoker),
+        )
+        for open_type, close_type in fixtures:
+            self.assertIn("operator_bond", open_type.DESCRIPTOR.fields_by_name)
+            self.assertEqual(close_type.DESCRIPTOR.fields_by_name["round_id"].number, 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
