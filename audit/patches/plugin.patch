+    with pytest.raises(PluginError):
+        run(contract._deliver_message_expire_room(
+            MessageExpireRoom(caller_address=PLAYER_A,round_id=rid),
+            height=1000 + ROOM_EXPIRY_BLOCKS,
+        ))
+    assert state.kv == before
