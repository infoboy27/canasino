diff --git a/tests/canasino-auth.test.js b/tests/canasino-auth.test.js
new file mode 100644
index 0000000..b411623
--- /dev/null
+++ b/tests/canasino-auth.test.js
@@ -0,0 +1,72 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+import { bls12_381 } from "../extension/lib/vendor/curves/bls12-381.mjs";
+import {
+  _internal, canopyAddressFromPublicKey, parseCanasinoAuthMessage,
+  signCanasinoAuthMessage, validateDisplayMatches,
+} from "../extension/lib/canasino-auth.js";
+
+const NOW = 2_000_000_000;
+const PRIVATE_KEY = new Uint8Array(32).fill(7);
+
+async function fixture(changes = {}) {
+  const proof = signCanasinoAuthMessage(PRIVATE_KEY, "00");
+  const address = await canopyAddressFromPublicKey(proof.publicKey);
+  const document = {
+    action: "join_room",
+    address,
+    challengeId: "12345678-1234-4234-8234-123456789abc",
+    chainId: 406,
+    domain: "canasino.org",
+    expiresAt: NOW + 120,
+    issuedAt: NOW,
+    networkId: 1,
+    nonce: "ab".repeat(32),
+    payloadHash: "cd".repeat(32),
+    resource: "round:0011223344556677",
+    version: "CANASINO-AUTH-V1",
+    ...changes,
+  };
+  const text = JSON.stringify(_internal.canonicalize(document));
+  return { address, document, messageHex: _internal.bytesToHex(new TextEncoder().encode(text)) };
+}
+
+test("validates and parses the exact canonical authorization bytes", async () => {
+  const { address, document, messageHex } = await fixture();
+  const parsed = parseCanasinoAuthMessage(messageHex, address, NOW + 1);
+  assert.deepEqual(parsed.document, document);
+  validateDisplayMatches(document, {
+    lines: [{ label: "Action", value: document.action }, { label: "Resource", value: document.resource }],
+  });
+});
+
+test("rejects noncanonical, expired, wrong-account and misleading display requests", async () => {
+  const valid = await fixture();
+  const noncanonical = _internal.bytesToHex(new TextEncoder().encode(JSON.stringify({
+    version: valid.document.version, ...valid.document,
+  })));
+  assert.throws(() => parseCanasinoAuthMessage(noncanonical, valid.address, NOW), /canonical/);
+  assert.throws(() => parseCanasinoAuthMessage(valid.messageHex, "ff".repeat(20), NOW), /connected account/);
+  assert.throws(() => parseCanasinoAuthMessage(valid.messageHex, valid.address, NOW + 121), /expired/);
+  assert.throws(() => validateDisplayMatches(valid.document, {
+    lines: [{ label: "Action", value: "roulette_bet" }, { label: "Resource", value: valid.document.resource }],
+  }), /does not match/);
+});
+
+test("BLS proof verifies independently over the unmodified message bytes", async () => {
+  const { address, messageHex } = await fixture();
+  const proof = signCanasinoAuthMessage(PRIVATE_KEY, messageHex);
+  assert.equal(await canopyAddressFromPublicKey(proof.publicKey), address);
+  assert.equal(bls12_381.verify(
+    _internal.hexToBytes(proof.signature),
+    _internal.hexToBytes(messageHex),
+    _internal.hexToBytes(proof.publicKey),
+  ), true);
+  const modified = `${messageHex.slice(0, -2)}00`;
+  assert.equal(bls12_381.verify(
+    _internal.hexToBytes(proof.signature),
+    _internal.hexToBytes(modified),
+    _internal.hexToBytes(proof.publicKey),
+  ), false);
+});
