diff --git a/extension/lib/canasino-auth.js b/extension/lib/canasino-auth.js
new file mode 100644
index 0000000..b53b933
--- /dev/null
+++ b/extension/lib/canasino-auth.js
@@ -0,0 +1,106 @@
+import { blsPublicKeyFromPriv, blsSign } from "./canopy-bls.js";
+
+const AUTH_KEYS = [
+  "action", "address", "chainId", "challengeId", "domain", "expiresAt",
+  "issuedAt", "networkId", "nonce", "payloadHash", "resource", "version",
+];
+const ACTIONS = new Set([
+  "join_room", "roulette_bet", "join_domino", "domino_move",
+  "join_poker", "poker_action", "read_private_state",
+]);
+
+function hexToBytes(value) {
+  if (typeof value !== "string" || value.length === 0 || value.length > 8192 ||
+      value.length % 2 !== 0 || !/^[0-9a-f]+$/i.test(value)) {
+    throw new Error("messageHex must be non-empty even-length hex (max 4096 bytes)");
+  }
+  const out = new Uint8Array(value.length / 2);
+  for (let i = 0; i < out.length; i++) out[i] = parseInt(value.slice(i * 2, i * 2 + 2), 16);
+  return out;
+}
+
+function bytesToHex(value) {
+  return Array.from(value, (byte) => byte.toString(16).padStart(2, "0")).join("");
+}
+
+function canonicalize(value) {
+  if (Array.isArray(value)) return value.map(canonicalize);
+  if (value && typeof value === "object") {
+    return Object.fromEntries(Object.keys(value).sort().map((key) => [key, canonicalize(value[key])]));
+  }
+  return value;
+}
+
+export function parseCanasinoAuthMessage(messageHex, expectedAddress, now = Math.floor(Date.now() / 1000)) {
+  const bytes = hexToBytes(messageHex);
+  let text, document;
+  try {
+    text = new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+    document = JSON.parse(text);
+  } catch (error) {
+    throw new Error("authorization message must be valid UTF-8 JSON", { cause: error });
+  }
+  if (!document || Array.isArray(document) || typeof document !== "object") {
+    throw new Error("authorization message must be a JSON object");
+  }
+  if (JSON.stringify(Object.keys(document).sort()) !== JSON.stringify(AUTH_KEYS)) {
+    throw new Error("authorization message has unexpected fields");
+  }
+  if (JSON.stringify(canonicalize(document)) !== text) {
+    throw new Error("authorization message is not canonical JSON");
+  }
+  if (document.version !== "CANASINO-AUTH-V1") throw new Error("unsupported authorization version");
+  if (!/^[a-f0-9]{40}$/.test(document.address) || document.address !== expectedAddress) {
+    throw new Error("authorization address does not match the connected account");
+  }
+  if (!ACTIONS.has(document.action)) throw new Error("unsupported authorization action");
+  if (!/^[a-z0-9.-]{1,253}$/.test(document.domain) || document.domain.startsWith(".") || document.domain.endsWith(".")) {
+    throw new Error("invalid authorization domain");
+  }
+  if (typeof document.resource !== "string" || document.resource.length < 1 ||
+      document.resource.length > 256 || !/^[\x20-\x7e]+$/.test(document.resource)) {
+    throw new Error("invalid authorization resource");
+  }
+  if (!/^[a-f0-9]{64}$/.test(document.nonce) || !/^[a-f0-9]{64}$/.test(document.payloadHash)) {
+    throw new Error("invalid authorization nonce or payload hash");
+  }
+  if (!/^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/.test(document.challengeId)) {
+    throw new Error("invalid authorization challenge id");
+  }
+  for (const key of ["chainId", "networkId", "issuedAt", "expiresAt"]) {
+    if (!Number.isSafeInteger(document[key]) || document[key] <= 0) throw new Error(`invalid ${key}`);
+  }
+  if (document.expiresAt <= document.issuedAt || document.expiresAt - document.issuedAt > 300 ||
+      document.issuedAt > now + 30 || document.expiresAt < now) {
+    throw new Error("authorization message is expired or has an invalid lifetime");
+  }
+  return { bytes, document };
+}
+
+export function validateDisplayMatches(document, display) {
+  if (display === undefined) return;
+  const lines = display?.lines;
+  if (!Array.isArray(lines)) throw new Error("authorization display must match signed fields");
+  const values = new Map(lines.map((line) => [line?.label, line?.value]));
+  if (values.get("Action") !== document.action || values.get("Resource") !== document.resource) {
+    throw new Error("authorization display does not match signed fields");
+  }
+}
+
+export function signCanasinoAuthMessage(privateKey, messageHex) {
+  if (!(privateKey instanceof Uint8Array) || privateKey.length !== 32) {
+    throw new Error("Canasino authorization requires a 32-byte BLS account");
+  }
+  const message = hexToBytes(messageHex);
+  return {
+    publicKey: bytesToHex(blsPublicKeyFromPriv(privateKey)),
+    signature: bytesToHex(blsSign(privateKey, message)),
+  };
+}
+
+export async function canopyAddressFromPublicKey(publicKeyHex) {
+  const digest = await crypto.subtle.digest("SHA-256", hexToBytes(publicKeyHex));
+  return bytesToHex(new Uint8Array(digest).slice(0, 20));
+}
+
+export const _internal = { canonicalize, hexToBytes, bytesToHex, AUTH_KEYS, ACTIONS };
